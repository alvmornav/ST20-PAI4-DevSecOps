<mxfile host="app.diagrams.net"><diagram name="1.b Flujo vulnerabilidad" id="st20-1b"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" pageWidth="1500" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#0F5C63&quot;&gt;Diagrama 1.b · Flujo ante una vulnerabilidad · ST20&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="40" as="geometry"/></mxCell><mxCell id="push" value="&lt;b&gt;&lt;font color='#5B6B82'&gt;Push / pull request&lt;/font&gt;&lt;/b&gt;&lt;br&gt;nuevo código en el repo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#5B6B82;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="scan" value="&lt;b&gt;&lt;font color='#0F5C63'&gt;Análisis en el pipeline&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SCA · SAST · IaC · Container · DAST" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F2F3;strokeColor=#0F5C63;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="dd" value="&lt;b&gt;&lt;font color='#B7791F'&gt;DefectDojo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;reimport-scan de cada informe&lt;br&gt;deduplicación" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;¿Supera el umbral&lt;br&gt;de su gate?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F5C6