<mxfile host="app.diagrams.net"><diagram name="1.a Pipeline" id="st20-1a"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" pageWidth="1460" pageHeight="900" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="group" value="&lt;b&gt;Análisis de seguridad (en paralelo)&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;fillColor=#FAFBFB;strokeColor=#9AA5A6;html=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#4A5556;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="330" height="550" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;&lt;font style='font-size:20px' color='#0F5C63'&gt;Diagrama 1.a · Pipeline DevSecOps · ST20&lt;/font&gt;&lt;/b&gt;&lt;br&gt;GitHub Actions sobre OWASP Juice Shop · 8 jobs · 6 quality gates · hallazgos centralizados en DefectDojo" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="55" as="geometry"/></mxCell><mxCell id="trigger" value="&lt;b&gt;&lt;font color='#5B6B82'&gt;Disparador&lt;/font&gt;&lt;/b&gt;&lt;br&gt;push a main y demo/gate&lt;br&gt;pull request a main&lt;br&gt;workflow_dispatch" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#5B6B82;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="180" height="100" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;&lt;font color='#0F5C63'&gt;build&lt;/font&gt;&lt;/b&gt;&lt;br&gt;docker build (caché GHA)&lt;br&gt;docker save → image.tar&lt;br&gt;artefacto: image" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F2F3;strokeColor=#0F5C63;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="470" width="200" height="110" as="geometry"/></mxCell><mxCell id="sca" value="&lt;b&gt;&lt;font color='#0F5C63'&gt;sca · OWASP Dependency-Check&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SCA · package-lock.json + NVD&lt;br&gt;&lt;span style='background-color:#FCEFC7;color:#B7791F;border:1px solid #B7791F;border-radius:8px;padding:1px 6px'&gt;&lt;b&gt;G1 · aviso · CVSS ≥ 7.0&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F2F3;strokeColor=#0F5C63;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="140" width="300" height="86" as="geometry"/></mxCell><mxCell id="sast" value="&lt;b&gt;&lt;font color='#0F5C63'&gt;sast · Semgrep&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SAST + secretos · OWASP Top 10, nodejsscan&lt;br&gt;&lt;span style='background-color:#FCEFC7;color:#B7791F;border:1px solid #B7791F;border-radius:8px;padding:1px 6px'&gt;&lt;b&gt;G2 · aviso · ≥ 1 ERROR&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F2F3;strokeColor=#0F5C63;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="242" width="300" height="86" as="geometry"/></mxCell><mxCell id="iac" value="&lt;b&gt;&lt;font color='#0F5C63'&gt;iac · Checkov&lt;/font&gt;&lt;/b&gt;&lt;br&gt;IaC · Dockerfile y k8s/ (2 tests)&lt;br&gt;&lt;span style='background-color:#FCEFC7;color:#B7791F;border:1px solid #B7791F;border-radius:8px;padding:1px 6px'&gt;&lt;b&gt;G3 · aviso · ≥ 1 check fallido&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F2F3;strokeColor=#0F5C63;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="344" width="300" height="86" as="geometry"/></mxCell><mxCell id="container" value="&lt;b&gt;&lt;font color='#0F5C63'&gt;container · Trivy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Imagen · SO base + paquetes (image.tar)&lt;br&gt;&lt;span style='background-color:#FCEFC7;color:#B7791F;border:1px solid #B7791F;border-radius:8px;padding:1px 6px'&gt;&lt;b&gt;G4 · aviso · ≥ 1 CRITICAL con parche&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F2F3;strokeColor=#0F5C63;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="446" width="300" height="86" as="geometry"/></mxCell><mxCell id="dast" value="&lt;b&gt;&lt;font color='#0F5C63'&gt;dast · OWASP ZAP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;DAST · app en ejecución (ajax spider)&lt;br&gt;&lt;span style='background-color:#F6D5D5;color:#B83232;border:1px solid #B83232;border-radius:8px;padding:1px 6px'&gt;&lt;b&gt;G5 · bloqueante · ≥ 1 alerta High&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F2F3;strokeColor=#0F5C63;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="548" width="300" height="86" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;&lt;font color='#0F5C63'&gt;security-gate&lt;/font&gt;&lt;/b&gt;&lt;br&gt;needs: sca, sast, iac, container, dast&lt;br&gt;CVSS ≥ 9.0 (SCA) o CRITICAL (Trivy)&lt;br&gt;+ resumen de DefectDojo&lt;br&gt;Check obligatorio en main&lt;br&gt;&lt;span style='background-color:#F6D5D5;color:#B83232;border:1px solid #B83232;border-radius:8px;padding:1px 6px'&gt;&lt;b&gt;G6 · bloqueante&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F2F3;strokeColor=#0F5C63;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="935" y="285" width="220" height="150" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;&lt;font color='#2E7D4F'&gt;deploy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;needs: dast, security-gate&lt;br&gt;no se ejecuta en pull request&lt;br&gt;push a GHCR (imagen:sha)&lt;br&gt;kind + kubectl apply -f k8s/&lt;br&gt;rollout status + smoke test" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F1E6;strokeColor=#2E7D4F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="285" width="215" height="150" as="geometry"/></mxCell><mxCell id="notify" value="&lt;b&gt;&lt;font color='#6B4E9B'&gt;notify&lt;/font&gt;&lt;/b&gt;&lt;br&gt;if: failure()&lt;br&gt;aviso por Discord con el&lt;br&gt;enlace al run" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3EEF8;strokeColor=#6B4E9B;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="500" width="215" height="95" as="geometry"/></mxCell><mxCell id="dd" value="&lt;b&gt;&lt;font color='#B7791F'&gt;OWASP DefectDojo  ·  Product Type SSII  ·  Producto Juice Shop ST20  ·  Engagement CI/CD GitHub Actions&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Tests: SCA - Dependency-Check · SAST - Semgrep · IaC - Checkov (+ K8s) · Container - Trivy · DAST - ZAP&lt;br&gt;scripts/dd-upload.sh → /api/v2/reimport-scan/ (close_old_findings) · deduplicación entre herramientas y ejecuciones&lt;br&gt;Triage: verificado · falso positivo · riesgo aceptado · SLA por severidad   |   Expuesto con Cloudflare Tunnel (HTTPS)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="710" width="890" height="100" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="trigger" target="build"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="trigger" target="sca"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="trigger" target="sast"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="trigger" target="iac"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="image.tar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="build" target="container"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="image.tar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="build" target="dast"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="sca" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="sast" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="iac" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="container" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="dast" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="si pasa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;" edge="1" parent="1" source="gate" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="si falla" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;dashed=1;" edge="1" parent="1" source="gate" target="notify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A5556;fontSize=10;fontStyle=2;dashed=1;" edge="1" parent="1" source="deploy" target="notify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="reimport-scan de cada informe (if: always())" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B7791F;fontSize=10;fontStyle=2;dashed=1;strokeWidth=2;fontColor=#B7791F;fontStyle=1;" edge="1" parent="1" source="group" target="dd"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>